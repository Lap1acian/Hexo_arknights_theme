// RHINE LAB palette override
// True dual-mode: dark mode uses dark panels + light text;
// light mode uses cream panels + ink text. Both keep a muted sage accent.
// Custom vars used by this file:
//   --rl-overlay  : overlay tint laid on top of the body image
//   --rl-key-bg   : kbd cap surface
//   --rl-key-shadow : inset shadow under kbd cap

:root[theme-mode=dark]
  --theme-highlight #7daf94
  --theme-subcolor #a3cfb6
  --theme-stress #d57a73
  --theme-kbd-shadow rgba(0, 0, 0, .4)
  --theme-kbd-text #eef2ed
  --theme-cursor #cdd6d0
  --theme-cursor-bg rgba(255, 255, 255, .14)
  --theme-text-hover #0f1612
  --theme-text #cdd5d0
  --theme-text-light #eef2ed
  --theme-text-rev #0f1612
  --theme-background #0d1311
  --theme-bg-trans0 rgba(26, 36, 33, .985)
  --theme-bg-trans1 rgba(26, 36, 33, .94)
  --theme-bg-trans2 rgba(35, 47, 43, .92)
  --theme-bg-hover #243430
  --theme-bg-light #1f2a26
  --theme-bg-soft rgba(255, 255, 255, .04)
  --theme-bg-soft-hover rgba(125, 175, 148, .14)
  --theme-ex-header rgba(255, 255, 255, .22)
  --theme-btn-bg #2a3733
  --theme-border #3a4641
  --theme-border-light #cdd5d0
  --theme-border-soft rgba(255, 255, 255, .12)
  --theme-unimportant #9aa39d
  --theme-unimportant-trans rgba(154, 163, 157, .35)
  --theme-unimportant-2 #6b7570
  --theme-td-border rgba(255, 255, 255, .14)
  --theme-td-hover rgba(125, 175, 148, .12)
  --theme-tag-bg #2a3733
  --theme-tag-count-bg #344440
  --theme-tag-border #3a4641
  --theme-loadingbar #a3cfb6
  --theme-loadingbar-fail #d57a73
  --theme-hide #eef2ed
  --theme-bar-color-0 rgba(125, 175, 148, .55)
  --theme-bar-color-1 rgba(125, 175, 148, .35)
  --theme-bar-color-2 rgba(255, 255, 255, .12)
  --theme-bar-color-3 rgba(255, 255, 255, .04)
  --rl-overlay rgba(13, 19, 17, .72)
  --rl-key-bg #243430
  --rl-key-shadow rgba(0, 0, 0, .35)
  --rl-glass-bg rgba(26, 36, 33, .45)

:root[theme-mode=light]
  --theme-highlight #3a7560
  --theme-subcolor #5b9881
  --theme-stress #b94d47
  --theme-kbd-shadow rgba(17, 24, 22, .2)
  --theme-kbd-text #141a18
  --theme-cursor #1f2a26
  --theme-cursor-bg rgba(17, 24, 22, .12)
  --theme-text-hover #f8f7f0
  --theme-text #2a322f
  --theme-text-light #141a18
  --theme-text-rev #f8f7f0
  --theme-background #eaeae3
  --theme-bg-trans0 rgba(248, 247, 240, .985)
  --theme-bg-trans1 rgba(248, 247, 240, .95)
  --theme-bg-trans2 rgba(232, 230, 220, .94)
  --theme-bg-hover #1a201d
  --theme-bg-light #f8fbf9
  --theme-bg-soft rgba(17, 24, 22, .045)
  --theme-bg-soft-hover rgba(58, 117, 96, .12)
  --theme-ex-header rgba(17, 24, 22, .18)
  --theme-btn-bg #e1e1d8
  --theme-border #1f2a26
  --theme-border-light #141a18
  --theme-border-soft rgba(17, 24, 22, .15)
  --theme-unimportant #5e6663
  --theme-unimportant-trans rgba(94, 102, 99, .32)
  --theme-unimportant-2 #898f8a
  --theme-td-border rgba(17, 24, 22, .22)
  --theme-td-hover rgba(58, 117, 96, .1)
  --theme-tag-bg #dcdcd2
  --theme-tag-count-bg #cccdc1
  --theme-tag-border #d2d2c8
  --theme-loadingbar #5b9881
  --theme-loadingbar-fail #b94d47
  --theme-hide #141a18
  --theme-bar-color-0 rgba(58, 117, 96, .55)
  --theme-bar-color-1 rgba(58, 117, 96, .35)
  --theme-bar-color-2 rgba(17, 24, 22, .18)
  --theme-bar-color-3 rgba(17, 24, 22, .06)
  --rl-overlay rgba(234, 234, 227, .55)
  --rl-key-bg #f5f4ee
  --rl-key-shadow rgba(17, 24, 22, .12)
  --rl-glass-bg rgba(248, 247, 240, .55)

body
  color var(--theme-text)
  background-color var(--theme-background)
  background-image linear-gradient(var(--rl-overlay), var(--rl-overlay)), linear-gradient(var(--theme-border-soft) 1px, transparent 1px), linear-gradient(90deg, var(--theme-border-soft) 1px, transparent 1px), var(--body-background)
  background-size auto auto, 32px 32px, 32px 32px, cover
  background-repeat no-repeat, repeat, repeat, no-repeat
  background-position 0 0, 0 0, 0 0, 50% 0

article,
#navigation,
#total,
#post-bg,
#archive-aside,
#Categories,
#Archives
  box-shadow 0 8px 22px rgba(0, 0, 0, .06)

#post-bg,
#navigation,
#total,
#Archives,
#Categories,
#archive-aside
  border-color var(--theme-border-soft)

// Glassy post list (inspired by angine.tech): one blur layer on the
// container, translucent stacked cards on top, no per-card dividers.
// --rl-glass-bg is a more transparent companion to --theme-bg-trans1
// so the body image shows through after blur.
.posts
  backdrop-filter blur(24px) saturate(140%)
  -webkit-backdrop-filter blur(24px) saturate(140%)

.posts .recent-post
  background-color var(--rl-glass-bg)
  border none
  margin-bottom 0
  box-shadow none

@media (min-width: 769px)
  .posts .recent-post:hover
    background-color var(--theme-highlight)

// Give the aside its own pale panel (both mobile + desktop) so the
// near-ink text we set via --theme-text-light stays legible. The original
// arknights theme assumed near-white text on a dark body, but we inverted
// the panel/text contrast for the reference palette.
aside
  background-color var(--theme-bg-trans1)
  border 1px solid var(--theme-border-soft)
  box-shadow 0 8px 22px rgba(0, 0, 0, .06)
  padding 18px 20px
  box-sizing border-box

aside footer
  color var(--theme-unimportant)

#description p,
#Dr a,
.social
  color var(--theme-text-light)

#navigation,
#total
  background-color transparent

#total-archives
  border-left-color var(--theme-border-light)

@media (max-width: 768px)
  aside
    margin-top 12px

// ── Component refinements ───────────────────────────────────────────────────

// Blockquote: sage left bar + faint sage tint instead of ink tint
blockquote
  border-left-color var(--theme-highlight)
  border-left-width 4px
  background-color rgba(93, 141, 121, .07)

// Inline code: subtle sage chip; works on both cream and dark panels
:not(pre) > code
  background-color var(--theme-bg-soft-hover) !important
  border 1px solid var(--theme-border-soft)
  border-radius 2px
  padding 0 4px !important

// kbd: paper-key in light mode, dark cap in dark mode (driven by --rl-key-*)
kbd
  background-color var(--rl-key-bg)
  color var(--theme-text-light)
  border 1px solid var(--theme-border-soft)
  border-radius 3px
  box-shadow 0 1px 0 var(--theme-border-soft), inset 0 -1px 0 var(--rl-key-shadow)
  padding 0 6px

// Table heading on the structural ink color so it reads as a hard panel header
table th
  background-color var(--theme-border)
  color var(--theme-text-rev)

#paginator a,
#paginator span,
.read-more,
button,
summary
  border-radius 2px

#post-title h1,
.recent-post h1,
#Dr a,
h1, h2, h3, h4, h5, h6
  letter-spacing .02em

::selection
  background-color var(--theme-highlight)
  color #f6f8f6

::-moz-selection
  background-color var(--theme-highlight)
  color #f6f8f6

// ── Theme-toggle transitions ────────────────────────────────────────────────
// Smooth cross-fade between dark/light modes for the surfaces and text that
// actually swap. Keep duration short so navigation/hover stay snappy.

html,
body,
aside,
article,
.recent-post,
.recent-post .categories,
.recent-post .tags,
.recent-post time,
.recent-post a,
#post-bg,
#post-content,
#navigation,
#total,
#total-archives,
#Archives,
#Categories,
#archive-aside,
header,
nav,
.navItem,
.navItemTitle,
.navBlock,
blockquote,
table,
table th,
table td,
:not(pre) > code,
pre,
kbd,
.read-more,
.post-sticky,
.headerlink,
button,
summary,
#paginator a,
#paginator span,
h1, h2, h3, h4, h5, h6
  transition background-color .35s ease, color .35s ease, border-color .35s ease, box-shadow .35s ease
